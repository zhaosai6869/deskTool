<Window x:Class="DeskApp.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="输入" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FBFBFD">
    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="LabelText" Grid.Row="0" Text="" FontSize="13"
                   Foreground="#1F1F1F" Margin="0,0,0,10"/>
        <TextBox x:Name="ValueBox" Grid.Row="1" Style="{StaticResource Input}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button Content="确定" Width="120" Appearance="Primary" IsDefault="True"
                      Style="{StaticResource ActionButton}" Click="Ok_Click"/>
            <ui:Button Content="取消" Width="120" Margin="10,0,0,0" Appearance="Secondary"
                      IsCancel="True" Style="{StaticResource ActionButton}" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
