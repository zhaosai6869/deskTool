<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        AppTheme：桌面工具（DeskApp）统一视觉语言（单一来源）。
        配色：文字 #1F1F1F / 次要文字 #5A6472 / 强调蓝 #0F6CBD /
             边框 #D8DEE6、浅边框 #E5E9F0 / 卡片白 / 表头 #F3F6FA / 面板 #F5F8FC。
        新页面请直接引用下述 keyed 样式；ContextMenu / MenuItem 为隐式全局，自动统一。
    -->

    <!-- ============ 操作按钮：大点击区 + 边框常驻（正常/悬停/按下都不消失） ============ -->
    <!-- WPF-UI 的 ui:Button 模板在 hover 时会把 ContentBorder.BorderBrush 绑到
         MouseOverBorderBrush，按下时绑到 PressedBorderBrush；Appearance=Primary 的模板触发器
         还把 PressedBorderBrush 设为透明 DynamicResource，Secondary 的 MouseOverBorderBrush
         也可能解析为空 —— 这就是「鼠标移入边框不显示」的根因。
         Style.Triggers 的优先级高于 ControlTemplate.Triggers，这里在 IsEnabled=True 时强制
         三个状态用同一个可见画刷，边框便在任何状态都保持显示；同时去掉缩放动画，
         避免点击范围只在 hover 时才变化。 -->
    <Style x:Key="ActionButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <!-- WPF-UI 模板的 ContentBorder.Background 默认是 null，空区域不参与命中测试
             （只有文字能点）。置为 Transparent 后整块按钮区域都可点击，视觉无变化。 -->
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#B8C0CC"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <!-- 常驻边框：覆盖模板按 Appearance / hover / pressed 改透明画刷的行为 -->
            <Trigger Property="IsEnabled" Value="True">
                <Setter Property="BorderBrush" Value="#B8C0CC"/>
                <Setter Property="MouseOverBorderBrush" Value="#B8C0CC"/>
                <Setter Property="PressedBorderBrush" Value="#B8C0CC"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.88"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.76"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ 首页模块卡片按钮 ============
         不用 ui:Button：其模板边框/背景依赖未合并的 WPF-UI 主题画刷，浅色下常常解析为 null，
         看起来像一堆散落文字。这里自绘白底圆角卡片，hover 蓝边，整块区域都可点击。 -->
    <Style x:Key="ModuleCardButton" TargetType="Button">
        <Setter Property="Width" Value="176"/>
        <Setter Property="Height" Value="126"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#D8DEE6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F3F8FE"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#0F6CBD"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E3EFFC"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 模块管理里的小图标按钮（↑↓ 排序） ============ -->
    <Style x:Key="MiniIconButton" TargetType="Button">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#5A6472"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="#FFFFFF" BorderBrush="#D8DEE6"
                            BorderThickness="1" CornerRadius="5" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#EAF2FB"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#0F6CBD"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DCEBFA"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                            <Setter TargetName="Bd" Property="Background" Value="#F5F6F8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 标题栏按钮：统一 46x40，主窗口与设置窗口同一风格 ============ -->
    <Style x:Key="CaptionBtn" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1A808080"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#30808080"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 文本输入框（TextBox） ============ -->
    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="#D8DEE6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#1F1F1F"/>
        <Setter Property="FontSize" Value="13"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="#0F6CBD"/>
                <Setter Property="BorderThickness" Value="1.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 密码类输入统一使用 Input（TextBox）明文显示，不再提供 PasswordBox 样式 -->

    <!-- ============ 字段标签（TextBlock） ============ -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#3C4655"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============ 复选框：自绘方框，未勾选也清晰可见（WPF-UI 默认框在浅色主题下几乎不可见） ============ -->
    <!-- 注意：必须为 keyed 局部/全局引用，切勿做成 App.xaml 隐式全局 CheckBox 样式（会触发 WPF-UI 窗口 AllowsTransparency 崩溃） -->
    <Style x:Key="ModuleCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="#1F1F1F"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4"
                                Background="White" BorderBrush="#5A6472" BorderThickness="1.8"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Path x:Name="Tick" Data="M 1,5 L 5,9 L 12,1"
                                  Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="Uniform" Width="12" Height="12"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#0F6CBD"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="#0F6CBD"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#0F6CBD"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 表格列头 ============ -->
    <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#F3F6FA"/>
        <Setter Property="Foreground" Value="#1F1F1F"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="#D8DEE6"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>

    <!-- ============ 表格单元格文本 ============ -->
    <Style x:Key="CellText" TargetType="TextBlock">
        <Setter Property="Margin" Value="10,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="#1F1F1F"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- ============ 面板标题（TextBlock） ============ -->
    <Style x:Key="PanelTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#1F1F1F"/>
    </Style>

    <!-- ============ 设置页导航项（RadioButton） ============ -->
    <Style x:Key="NavRadio" TargetType="RadioButton">
        <Setter Property="Height" Value="42"/>
        <Setter Property="Margin" Value="8,2"/>
        <Setter Property="Foreground" Value="#1F1F1F"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="SettingsNav"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6"/>
                        <Border x:Name="Bar" Width="3" Height="20" HorizontalAlignment="Left"
                                Background="Transparent" CornerRadius="2"/>
                        <ContentPresenter Margin="18,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#E3EFFC"/>
                            <Setter TargetName="Bar" Property="Background" Value="#0F6CBD"/>
                            <Setter Property="Foreground" Value="#0F6CBD"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#EAF0F8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 表格统一外观（两个列表页共用） ============ -->
    <Style x:Key="AppDataGrid" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#E8ECF1"/>
        <Setter Property="VerticalGridLinesBrush" Value="#E8ECF1"/>
        <Setter Property="BorderBrush" Value="#D8DEE6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="AlternatingRowBackground" Value="#FAFBFD"/>
        <Setter Property="Foreground" Value="#1F1F1F"/>
        <Setter Property="RowHeight" Value="36"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource GridHeader}"/>
    </Style>

    <!-- ============ 右键菜单：Fluent 风格（圆角 + 悬停高亮），与主页面白卡片/蓝色调统一 ============ -->
    <!-- 隐式全局：任何页面右键菜单自动统一，无需逐处引用 -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#D8DEE6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ScrollViewer Focusable="False" CanContentScroll="True">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="#1F1F1F"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                            Margin="2,1" Padding="12,8">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                          Margin="2,0" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#EAF1F8"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DCE8F5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#A6ABB4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 菜单分隔线：与卡片/表格浅边框同色 -->
    <Style TargetType="Separator">
        <Setter Property="Margin" Value="8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="#E5E9F0" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ ComboBox 画刷补齐 ============
         本工程 App.xaml 只合并了 ui:ControlsDictionary（控件样式），未合并 WPF-UI 的主题色字典，
         因此模板里 DynamicResource 引用的所有主题画刷解析为 null —— 下拉弹层
         ComboBoxDropDownBackground 为空就是「下拉没有背景、能透出后面内容」的根因。
         这里按现有浅色配色补齐 ComboBox 用到的全部键，其他控件不受影响。 -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#F7F9FC"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#F2F4F7"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#D8DEE6"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#0F6CBD"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#E5E9F0"/>
    <SolidColorBrush x:Key="ComboBoxForeground" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#9AA4B2"/>
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#5A6472"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#D8DEE6"/>
    <CornerRadius x:Key="PopupCornerRadius">6</CornerRadius>

    <!-- ============ 自定义 ComboBox（一键启动等长列表用） ============
         WPF-UI 原生模板有两个坑：① 弹层用 ui:DynamicScrollViewer（overlay 滚动条，内容超出也不显示，
         且滚动条主题画刷全 NULL）；② ComboBoxItem 的 hover 背景绑 DynamicResource
         ComboBoxItemBackgroundSelected（本工程未合并主题字典 → NULL → 悬停无高亮）。
         这里给 ComboBox / ComboBoxItem 自带 ControlTemplate：标准 ScrollViewer（内容超出即出滚动条，
         可滚轮/拖动/点轨道）+ 触发器直接设 Border 背景（悬停高亮稳定生效），完全不依赖主题画刷。 -->
    <Style x:Key="AppComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="40"/>
        <Setter Property="MaxDropDownHeight" Value="280"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#1F1F1F"/>
        <Setter Property="BorderBrush" Value="#D8DEE6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,0,32,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="ContentBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter x:Name="ContentSite" Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  IsHitTestVisible="False"/>
                                <Path x:Name="Arrow" Data="M0,0 L5,5 L10,0" Stroke="#5A6472"
                                      StrokeThickness="1.5" HorizontalAlignment="Right" Margin="0,0,12,0"
                                      VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                            </Grid>
                        </Border>
                        <!-- 覆盖整框的透明 ToggleButton：整块都能点开，视觉无变化。
                             必须显式 Stretch —— WPF-UI 默认给 ToggleButton 的对齐是 Left/Center，
                             不写就会塌成 0x0 完全点不到（下拉打不开的根因）。 -->
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Background="Transparent" BorderThickness="0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="Popup" Placement="Bottom" VerticalOffset="1" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Slide"
                               IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border x:Name="DropDownBorder" Background="#FFFFFF" BorderBrush="#D8DEE6"
                                    BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              CanContentScroll="True" Padding="0,4">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="#0F6CBD"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="#0F6CBD"/>
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value><RotateTransform Angle="180" CenterX="5" CenterY="2.5"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 下拉项/闭合态共用的显示模板：绑定对象的 Name。
         自定义模板下 DisplayMemberPath 不会作用到闭合态（SelectionBoxItemTemplate=NULL → 显示类型全名），
         必须改用 ItemTemplate，WPF 才会为 SelectionBoxItemTemplate 生成同一模板，闭合态才显示 Name。 -->
    <DataTemplate x:Key="AppComboBoxItemTemplate">
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </DataTemplate>

    <!-- 自定义 ComboBoxItem：触发器直接设 Border 背景，鼠标移上去稳定高亮 -->
    <Style x:Key="AppComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="#1F1F1F"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          ContentSource="Content"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#EAF2FB"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#DCEDFB"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
