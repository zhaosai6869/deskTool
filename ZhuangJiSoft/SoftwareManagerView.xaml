<UserControl x:Class="DeskApp.SoftwareManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:DeskApp"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部：标题 + 操作（新增/修改/删除） -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <ui:TextBlock Text="装机软件" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                          Margin="0,0,16,0" Foreground="#1F1F1F"/>
            <ui:Button Content="新增" Click="Add_Click" Margin="0,0,8,0" Appearance="Primary"
                      Style="{StaticResource ActionButton}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Add24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="修改" Click="Edit_Click" Margin="0,0,8,0" Appearance="Secondary"
                      Style="{StaticResource ActionButton}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Edit24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="删除" Click="Delete_Click" Appearance="Danger"
                      Style="{StaticResource ActionButton}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Delete24" />
                </ui:Button.Icon>
            </ui:Button>
        </StackPanel>

        <!-- 统一的分隔线 -->
        <Border Grid.Row="1" Height="1" Background="#E5E9F0" Margin="0,0,0,12"/>

        <!-- 表格 -->
        <DataGrid Grid.Row="2" x:Name="Grid"
                  Style="{StaticResource AppDataGrid}"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="软件名称" Width="190"
                                    ElementStyle="{StaticResource CellText}" Binding="{Binding Name}"/>
                <DataGridTemplateColumn Header="下载地址" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Margin="10,0" VerticalAlignment="Center">
                                <Hyperlink Command="{Binding DataContext.OpenUrlCommand,
                                                             RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}"
                                           Foreground="#0F6CBD" TextDecorations="Underline">
                                    <TextBlock Text="{Binding DownloadUrl}" Foreground="#0F6CBD" FontSize="13"/>
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
