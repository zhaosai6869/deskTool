<ui:FluentWindow x:Class="DeskApp.SshTerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SSH 终端" Height="640" Width="1000"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0" CaptionHeight="40"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 与主窗口同风格的自绘标题栏 -->
        <Grid Grid.Row="0" x:Name="TitleBarGrid" MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <ui:SymbolIcon Symbol="WindowConsole20" FontSize="16" Margin="0,0,10,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock x:Name="TitleText" Text="SSH 终端" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource CaptionBtn}" ToolTip="最小化" Click="Minimize_Click">
                    <TextBlock Text="—" FontSize="14"/>
                </Button>
                <Button Style="{StaticResource CaptionBtn}" ToolTip="关闭" Click="Close_Click">
                    <TextBlock Text="✕" FontSize="13"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 连接状态条 + 文件管理入口（与列表页工具栏同风格） -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,0,16,10">
            <TextBlock x:Name="StatusText" Text="正在连接…" FontSize="13" Foreground="#5A6472"
                       VerticalAlignment="Center" Margin="0,0,16,0"/>
            <ui:Button Content="文件管理" Click="FileManager_Click" Appearance="Secondary"
                      Style="{StaticResource ActionButton}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Folder24" />
                </ui:Button.Icon>
            </ui:Button>
        </StackPanel>

        <!-- 终端区域：白底卡片，与主界面白卡片风格一致 -->
        <Border Grid.Row="2" Margin="16,0,16,16" Background="White"
                BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="6">
            <wv2:WebView2 x:Name="TermView" DefaultBackgroundColor="White"/>
        </Border>
    </Grid>
</ui:FluentWindow>
