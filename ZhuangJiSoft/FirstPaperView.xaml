<UserControl x:Class="DeskApp.FirstPaperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="1000">

    <UserControl.Resources>
        <!-- 主要操作按钮：蓝底白字，整块可点（不依赖未合并的 WPF-UI 主题画刷） -->
        <Style x:Key="PrimaryBlueButton" TargetType="ui:Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0F6CBD"/>
            <Setter Property="BorderBrush" Value="#0F6CBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0B5AA6"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0B5AA6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#084B8A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaperCellText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="ToolTip" Value="{Binding Error}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Error}" Value="">
                    <Setter Property="ToolTip" Value="{x:Null}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PaperStatusText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="失败">
                    <Setter Property="Foreground" Value="#C42B1C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="已下载">
                    <Setter Property="Foreground" Value="#1F8A4C"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="第一试卷下载" FontSize="20" FontWeight="Bold" Foreground="#1F1F1F"
                       VerticalAlignment="Center" Margin="0,0,14,0"/>
            <TextBlock Text="按学科 / 年级更新题库，勾选后批量下载" FontSize="13"
                       Foreground="#5A6472" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 第一行：学科 / 年级 / 更新题库 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="学科" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
            <ComboBox x:Name="SubjectCombo" Grid.Column="1" Style="{StaticResource AppComboBox}"
                      ItemsSource="{Binding Subjects}" DisplayMemberPath="Name"
                      SelectionChanged="SubjectCombo_SelectionChanged"/>
            <TextBlock Grid.Column="2" Text="年级" Style="{StaticResource FieldLabel}" Margin="16,0,8,0"/>
            <ComboBox x:Name="GradeCombo" Grid.Column="3" Style="{StaticResource AppComboBox}"
                      ItemsSource="{Binding Grades}"
                      SelectionChanged="GradeCombo_SelectionChanged"/>
            <ui:Button x:Name="UpdateBtn" Grid.Column="4" Content="更新题库" Style="{StaticResource PrimaryBlueButton}"
                       Margin="16,0,0,0" Width="100" Click="Update_Click"/>
            <TextBlock Grid.Column="5" Text="{Binding LibraryInfo}" FontSize="12" Foreground="#5A6472"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>

        <!-- 第二行：版本 / 关键词 / 查询 -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="版本" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
            <ComboBox x:Name="VersionCombo" Grid.Column="1" Style="{StaticResource AppComboBox}"
                      ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"/>
            <TextBlock Grid.Column="2" Text="关键词" Style="{StaticResource FieldLabel}" Margin="16,0,8,0"/>
            <TextBox x:Name="KeywordBox" Grid.Column="3" Style="{StaticResource Input}"
                     ToolTip="如：期中 / 期末 / 单元（可留空）" KeyDown="KeywordBox_KeyDown"/>
            <Button x:Name="ClearKeywordBtn" Grid.Column="4" Content="×" Width="26" Height="30"
                    Margin="4,0,0,0" FontSize="16" Background="Transparent" BorderThickness="0"
                    Foreground="#5A6472" Cursor="Hand" Click="ClearKeyword_Click"/>
            <ui:Button x:Name="QueryBtn" Grid.Column="5" Content="查询" Style="{StaticResource PrimaryBlueButton}"
                       Width="80" Click="Query_Click"/>
            <TextBlock Grid.Column="6" FontSize="12" Foreground="#5A6472"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                <Run Text="筛选出 "/><Run Text="{Binding FilteredCount, StringFormat=N0, Mode=OneWay}"/>
                <Run Text=" / 总计 "/><Run Text="{Binding TotalCount, StringFormat=N0, Mode=OneWay}"/><Run Text=" 份"/>
            </TextBlock>
        </Grid>

        <!-- 题库列表 -->
        <DataGrid Grid.Row="3" x:Name="PaperGrid" Style="{StaticResource AppDataGrid}"
                  ItemsSource="{Binding PageItems}" CanUserSortColumns="True">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="42" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource ModuleCheckBox}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Click="RowCheck_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="试卷标题" Width="*" Binding="{Binding Title}"
                                    ElementStyle="{StaticResource PaperCellText}"/>
                <DataGridTextColumn Header="版本" Width="100" Binding="{Binding Version}"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="大小" Width="90" Binding="{Binding SizeText}"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="上传日期" Width="110" Binding="{Binding TimeText}"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="状态" Width="110" Binding="{Binding Status}"
                                    ElementStyle="{StaticResource PaperStatusText}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 勾选 / 命名规则 / 分页 -->
        <Grid Grid.Row="4" Margin="0,10,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:Button x:Name="SelectAllBtn" Grid.Column="0" Content="全选本页" Style="{StaticResource ActionButton}"
                       Height="32" Padding="10,0" Click="SelectAll_Click"/>
            <ui:Button x:Name="ClearSelectBtn" Grid.Column="1" Content="取消全选" Style="{StaticResource ActionButton}"
                       Height="32" Padding="10,0" Margin="8,0,0,0" Click="ClearSelection_Click"/>
            <TextBlock Grid.Column="2" FontSize="13" Foreground="#0F6CBD" VerticalAlignment="Center"
                       Margin="14,0,0,0">
                <Run Text="已选 "/><Run Text="{Binding SelectedCount, Mode=OneWay}"/><Run Text=" 份"/>
            </TextBlock>
            <TextBlock Grid.Column="3" Text="命名规则" Style="{StaticResource FieldLabel}" Margin="18,0,8,0"/>
            <TextBox x:Name="NameRuleBox" Grid.Column="4" Style="{StaticResource Input}"
                     Text="{Binding NameTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="支持 [版本] [标题] [学科] [年级] [日期]"/>
            <Button x:Name="ClearRuleBtn" Grid.Column="5" Content="×" Width="26" Height="30"
                    Margin="4,0,8,0" FontSize="16" Background="Transparent" BorderThickness="0"
                    Foreground="#5A6472" Cursor="Hand" Click="ClearRule_Click"/>
            <ui:Button x:Name="PrevBtn" Grid.Column="6" Content="上一页" Style="{StaticResource ActionButton}"
                       Height="32" Padding="10,0" Click="Prev_Click"/>
            <TextBlock Grid.Column="7" VerticalAlignment="Center" Margin="10,0" FontSize="13" Foreground="#1F1F1F">
                <Run Text="第 "/><Run Text="{Binding PageIndex, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding PageCount, Mode=OneWay}"/><Run Text=" 页"/>
            </TextBlock>
            <ui:Button x:Name="NextBtn" Grid.Column="8" Content="下一页" Style="{StaticResource ActionButton}"
                       Height="32" Padding="10,0" Click="Next_Click"/>
        </Grid>

        <!-- 保存目录 / 下载 -->
        <Grid Grid.Row="5" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="保存到" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
            <TextBox x:Name="DirBox" Grid.Column="1" Style="{StaticResource Input}"
                     Text="{Binding DownloadDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <ui:Button x:Name="BrowseBtn" Grid.Column="2" Content="浏览..." Style="{StaticResource ActionButton}"
                       Height="34" Padding="12,0" Margin="8,0,0,0" Click="Browse_Click"/>
            <ui:Button x:Name="OpenDirBtn" Grid.Column="3" Content="打开文件夹" Style="{StaticResource ActionButton}"
                       Height="34" Padding="12,0" Margin="8,0,0,0" Click="OpenDir_Click"/>
            <ui:Button x:Name="DownloadBtn" Grid.Column="4" Content="开始下载" Style="{StaticResource PrimaryBlueButton}"
                       Height="34" Width="120" Margin="10,0,0,0" Click="Download_Click"/>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="6" Background="#F5F8FC" BorderBrush="#E5E9F0" BorderThickness="1"
                CornerRadius="6" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="12" Foreground="#5A6472"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="资源版权归原站点及上传者所有" FontSize="11"
                           Foreground="#8A94A3" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
