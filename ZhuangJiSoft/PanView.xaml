<UserControl x:Class="DeskApp.PanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="960">
    <UserControl.Resources>
        <local:BoolToLoginTextConverter xmlns:local="clr-namespace:DeskApp" x:Key="BoolToLoginText"/>
        <Style x:Key="PanPrimaryButton" TargetType="ui:Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0F6CBD"/>
            <Setter Property="BorderBrush" Value="#0F6CBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0B5AA6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SiteCard" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8DEE6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="8,4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0F6CBD"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0F6CBD"/>
                                <Setter TargetName="Bd" Property="Background" Value="#E8F2FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="网盘直链下载" FontSize="19" FontWeight="Bold" Foreground="#1F1F1F"
                       VerticalAlignment="Center" Margin="0,0,12,0" HorizontalAlignment="Left"/>
            <TextBlock Text="登录网盘 → 粘贴分享链接 → 解析 → 多线程下载" FontSize="12"
                       Foreground="#5A6472" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Margin="150,0,0,0"/>
        </Grid>

        <!-- 网盘站点卡片 -->
        <Border Grid.Row="1" Background="#F5F8FC" BorderBrush="#E5E9F0" BorderThickness="1"
                CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="选择网盘（点卡片切换，登录状态实时显示）" Style="{StaticResource FieldLabel}"
                           Margin="0,0,0,6"/>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Sites}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SiteCard}" Click="Site_Click" Tag="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="17" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#1F1F1F"/>
                                        <TextBlock Text="{Binding LoggedIn, Converter={StaticResource BoolToLoginText}}"
                                                   FontSize="10" Foreground="#0F6CBD"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- 登录 + 分享链接 -->
        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" x:Name="LoginBtn" Content="登录网盘" Style="{StaticResource PanPrimaryButton}"
                       Click="Login_Click" Margin="0,0,8,0"/>
            <ui:Button Grid.Column="1" x:Name="LogoutBtn" Content="退出登录" Style="{StaticResource ActionButton}"
                       Height="32" Padding="12,0" Click="Logout_Click" Margin="0,0,12,0"/>
            <TextBlock Grid.Column="2" Text="分享链接" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"
                       VerticalAlignment="Center"/>
            <TextBox Grid.Column="3" x:Name="UrlBox" Style="{StaticResource Input}"
                     Text="{Binding ShareUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="UrlBox_KeyDown"
                     ToolTip="粘贴网盘分享链接，程序会自动识别网盘"/>
        </Grid>

        <!-- 文件列表 -->
        <DataGrid Grid.Row="3" x:Name="FileGrid" Style="{StaticResource AppDataGrid}"
                  ItemsSource="{Binding Files}" CanUserSortColumns="False">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Row_PreviewMouseLeftButtonDown"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="38" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource ModuleCheckBox}" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" IsHitTestVisible="False"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="文件名" Width="*" Binding="{Binding Name}" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="大小" Width="90" Binding="{Binding SizeText}" ElementStyle="{StaticResource CellText}"/>
                <DataGridTemplateColumn Header="进度" Width="160" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="14" Minimum="0" Maximum="100"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="状态" Width="220" Binding="{Binding Status}" ElementStyle="{StaticResource CellText}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 解析 / 选择 -->
        <Grid Grid.Row="4" Margin="0,8,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" x:Name="ParseBtn" Content="解析分享链接" Style="{StaticResource PanPrimaryButton}"
                       Click="Parse_Click" Width="120"/>
            <ui:Button Grid.Column="1" x:Name="CancelBtn" Content="取消" Style="{StaticResource ActionButton}"
                       Height="32" Padding="12,0" Margin="8,0,0,0" Click="Cancel_Click"/>
            <ui:Button Grid.Column="2" x:Name="SelectAllBtn" Content="全选" Style="{StaticResource ActionButton}"
                       Height="32" Padding="12,0" Margin="8,0,0,0" Click="SelectAll_Click"/>
            <TextBlock Grid.Column="3" Text="解析失败多为未登录或链接失效；部分网盘需联调适配" FontSize="11"
                       Foreground="#8A94A3" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <!-- 保存目录 / 线程 / 下载 -->
        <Grid Grid.Row="5" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="保存到" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
            <TextBox Grid.Column="1" Style="{StaticResource Input}"
                     Text="{Binding DownloadDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <ui:Button Grid.Column="2" x:Name="BrowseBtn" Content="浏览..." Style="{StaticResource ActionButton}"
                       Height="32" Padding="12,0" Margin="8,0,0,0" Click="Browse_Click"/>
            <TextBlock Grid.Column="3" Text="线程" Style="{StaticResource FieldLabel}" Margin="12,0,6,0" VerticalAlignment="Center"/>
            <TextBox Grid.Column="4" Width="50" Height="32" Style="{StaticResource Input}"
                     Text="{Binding Threads, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <ui:Button Grid.Column="5" x:Name="DownloadBtn" Content="开始下载" Style="{StaticResource PanPrimaryButton}"
                       Width="110" Margin="10,0,0,0" Click="Download_Click"/>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="6" Background="#F5F8FC" BorderBrush="#E5E9F0" BorderThickness="1"
                CornerRadius="6" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="12" Foreground="#5A6472"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="仅供个人合法使用 · 请勿用于盗版分发" FontSize="11"
                           Foreground="#8A94A3" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
