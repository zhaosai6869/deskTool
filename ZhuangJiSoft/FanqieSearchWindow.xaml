<ui:FluentWindow x:Class="DeskApp.FanqieSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="搜索番茄小说" Height="700" Width="940"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0" CaptionHeight="40"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="TitleBarGrid" MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <ui:SymbolIcon Symbol="Cloud24" FontSize="16" Margin="0,0,10,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="搜索番茄小说" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource CaptionBtn}" ToolTip="最小化" Click="Minimize_Click">
                    <TextBlock Text="—" FontSize="14"/>
                </Button>
                <Button Style="{StaticResource CaptionBtn}" ToolTip="关闭" Click="Close_Click">
                    <TextBlock Text="✕" FontSize="13"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 关键词栏：返回 / 改词重搜 / 下载当前书 -->
        <Grid Grid.Row="1" Margin="16,10,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:Button x:Name="BackBtn" Grid.Column="0" Content="返回" Click="Back_Click" Margin="0,0,10,0"
                       Appearance="Secondary" Height="36" Width="76" Style="{StaticResource ActionButton}"
                       IsEnabled="False" ToolTip="回到上一个页面（书页/搜索页）"/>
            <TextBox x:Name="KeywordBox" Grid.Column="1" Style="{StaticResource Input}" Height="36"
                     VerticalContentAlignment="Center" Padding="10,0" KeyDown="KeywordBox_KeyDown"/>
            <ui:Button Grid.Column="2" Content="重新搜索" Click="Search_Click" Margin="10,0,0,0"
                       Appearance="Secondary" Height="36" Style="{StaticResource ActionButton}"
                       ToolTip="按新关键词重新加载搜索页"/>
            <ui:Button Grid.Column="3" Content="下载当前书" Click="DownloadCurrent_Click" Margin="10,0,0,0"
                       Appearance="Primary" Height="36" Style="{StaticResource ActionButton}"
                       ToolTip="从当前打开的书页获取书号并下载（不关闭本窗口，可连续下载）">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowDownload24"/>
                </ui:Button.Icon>
            </ui:Button>
        </Grid>

        <StackPanel Grid.Row="2" Margin="16,0,16,10">
            <TextBlock x:Name="StatusText"
                       Text="正在加载搜索页…若出现滑块验证，请手动完成；点进任意一本书的页面后，可点右上角「下载当前书」直接下载。"
                       FontSize="13" Foreground="#5A6472" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 网页区：滑块在此完成 -->
        <Border Grid.Row="3" Margin="16,0,16,10" Background="White"
                BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="6">
            <wv2:WebView2 x:Name="SearchView" DefaultBackgroundColor="White"/>
        </Border>

        <!-- 结果区：捕获到搜索结果后显示 -->
        <Border x:Name="ResultPanel" Grid.Row="4" Margin="16,0,16,16" Visibility="Collapsed"
                Background="#F5F8FC" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="6" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="120"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="ResultCountText" Text="搜索结果" FontSize="13"
                           FontWeight="SemiBold" Foreground="#1F1F1F" Margin="2,0,0,8"/>
                <ListBox Grid.Row="1" x:Name="ResultList" Background="White" BorderBrush="#D8DEE6"
                         BorderThickness="1" MouseDoubleClick="ResultList_DoubleClick"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="6,5">
                                <TextBlock Text="{Binding BookName}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#1F1F1F" Width="320" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Author}" FontSize="13" Foreground="#5A6472"
                                           Width="140" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding WordCountText}" FontSize="12" Foreground="#8A94A3"
                                           Width="90"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <ui:Button Content="下载选中" Click="Download_Click" Appearance="Primary"
                               Style="{StaticResource ActionButton}" Width="130">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowDownload24"/>
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Content="取消" Click="Cancel_Click" Appearance="Secondary"
                               Style="{StaticResource ActionButton}" Width="90" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
