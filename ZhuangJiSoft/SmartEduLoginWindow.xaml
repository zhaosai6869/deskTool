<ui:FluentWindow x:Class="DeskApp.SmartEduLoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                 mc:Ignorable="d"
                 Title="智慧教育平台登录"
                 Width="1000" Height="720"
                 MinWidth="760" MinHeight="560"
                 WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F5F8FC" BorderBrush="#E5E9F0" BorderThickness="0,0,0,1"
                Padding="16,10">
            <StackPanel>
                <TextBlock Text="国家中小学智慧教育平台 · 登录获取下载凭据" FontSize="16"
                           FontWeight="SemiBold" Foreground="#1F1F1F"/>
                <TextBlock Text="在下方官方页面用账号密码 / 短信 / 扫码登录；登录成功后程序自动读取凭据，账号密码不经过本程序。"
                           FontSize="12" Foreground="#5A6472" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <wv2:WebView2 x:Name="LoginView" Grid.Row="1"/>

        <Border Grid.Row="1" x:Name="LoadingMask" Background="#EEF3F9"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="正在初始化登录页面…" FontSize="14" Foreground="#5A6472"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#F5F8FC" BorderBrush="#E5E9F0" BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Text="等待登录…" FontSize="12"
                           Foreground="#5A6472" VerticalAlignment="Center"/>
                <ui:Button x:Name="RetryBtn" Grid.Column="1" Content="重新加载"
                           Style="{StaticResource ActionButton}" Height="32" Padding="12,0"
                           Margin="8,0,0,0" Click="RetryBtn_Click"/>
                <ui:Button x:Name="CancelBtn" Grid.Column="2" Content="取消"
                           Style="{StaticResource ActionButton}" Height="32" Padding="12,0"
                           Margin="8,0,0,0" Click="CancelBtn_Click"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
