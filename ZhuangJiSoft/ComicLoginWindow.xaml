<ui:FluentWindow x:Class="DeskApp.ComicLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="B漫登录" Height="720" Width="1020" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16,12,16,8">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="登录 哔哩哔哩漫画" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock x:Name="TipText"
                           Text="请在下方官方页面完成登录（扫码 / 账号密码 / 短信均可）。登录成功后会自动读取 SESSDATA 并保存，也可手动点「保存凭据」。账号密码不经过本程序。"
                           FontSize="12" Foreground="#5A6472" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="12,0">
            <wv2:WebView2 x:Name="LoginView"/>
            <Border x:Name="LoadingMask" Background="#CCFFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="正在加载哔哩哔哩漫画…" FontSize="13" Foreground="#5A6472" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Grid.Row="0" Grid.Column="0" Text="准备中…"
                           FontSize="12" Foreground="#0F6CBD" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="重新加载" Style="{StaticResource ActionButton}" Height="32" Padding="14,0"
                               Click="Reload_Click"/>
                    <ui:Button Content="复制诊断" Style="{StaticResource ActionButton}" Height="32" Padding="14,0"
                               Margin="8,0,0,0" Click="CopyDiag_Click"/>
                    <ui:Button Content="✅ 登录完成后点这里保存" Appearance="Primary" Height="32" Padding="16,0"
                               Margin="8,0,0,0" Click="Save_Click"/>
                    <ui:Button Content="取消" Style="{StaticResource ActionButton}" Height="32" Padding="16,0"
                               Margin="8,0,0,0" Click="Cancel_Click"/>
                </StackPanel>

                <TextBox x:Name="DiagLog" Grid.Row="1" Grid.ColumnSpan="2" Height="92" Margin="0,8,0,0"
                         Style="{x:Null}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="10"
                         Background="#1E1E1E" Foreground="#D4D4D4" BorderBrush="#3C3C3C" BorderThickness="1"
                         Padding="8,6" Text="诊断日志（实时）："/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
