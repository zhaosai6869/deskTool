<UserControl x:Class="DeskApp.WinRemoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:DeskApp"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部：标题 + 操作（新增/修改/删除/Ping 值） -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <ui:TextBlock Text="Win 远程" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                          Margin="0,0,16,0" Foreground="#1F1F1F"/>
            <ui:Button Content="新增" Click="Add_Click" Margin="0,0,8,0" Appearance="Primary"
                      Style="{StaticResource ActionButton}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Add24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="修改" Click="Edit_Click" Margin="0,0,8,0" Appearance="Secondary"
                      Style="{StaticResource ActionButton}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Edit24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="删除" Click="Delete_Click" Margin="0,0,8,0" Appearance="Danger"
                      Style="{StaticResource ActionButton}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Delete24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="Ping 值" Click="Ping_Click" Appearance="Primary"
                      Style="{StaticResource ActionButton}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Globe24" />
                </ui:Button.Icon>
            </ui:Button>
        </StackPanel>

        <!-- 统一的分隔线 -->
        <Border Grid.Row="1" Height="1" Background="#E5E9F0" Margin="0,0,0,12"/>

        <!-- 表格 -->
        <DataGrid Grid.Row="2" x:Name="Grid"
                  Style="{StaticResource AppDataGrid}"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  MouseDoubleClick="Grid_MouseDoubleClick"
                  MouseRightButtonDown="Grid_MouseRightButtonDown">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="复制密码" Click="CopyPassword_Click"/>
                    <MenuItem Header="复制信息" Click="CopyInfo_Click"/>
                    <MenuItem Header="测试 Ping" Click="TestPingOne_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Width="160"
                                    ElementStyle="{StaticResource CellText}" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="主机" Width="200"
                                    ElementStyle="{StaticResource CellText}" Binding="{Binding Host}"/>
                <DataGridTextColumn Header="端口" Width="64"
                                    ElementStyle="{StaticResource CellText}" Binding="{Binding Port}"/>
                <DataGridTextColumn Header="用户名" Width="130"
                                    ElementStyle="{StaticResource CellText}" Binding="{Binding UserName}"/>
                <DataGridTextColumn Header="密码" Width="80"
                                    ElementStyle="{StaticResource CellText}" Binding="{Binding PasswordMask}"/>
                <DataGridTextColumn Header="备注" Width="*" MinWidth="220"
                                    ElementStyle="{StaticResource CellText}" Binding="{Binding Notes}"/>
                <DataGridTemplateColumn Header="Ping" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Margin="10,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#0E8A2E"/>
                                        <Setter Property="Text" Value="{Binding PingMs}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PingMs}" Value="{x:Null}">
                                                <Setter Property="Foreground" Value="#D13438"/>
                                                <Setter Property="Text" Value="未连通"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
