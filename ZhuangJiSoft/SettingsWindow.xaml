<ui:FluentWindow x:Class="DeskApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeskApp"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="设置" Height="480" Width="720" WindowStartupLocation="Manual" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0" CaptionHeight="40"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 与主窗口同风格的自绘标题栏 -->
        <Grid Grid.Row="0" x:Name="TitleBarGrid" MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,10,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource CaptionBtn}" ToolTip="关闭" Click="Close_Click">
                <TextBlock Text="✕" FontSize="13"/>
            </Button>
        </Grid>

        <!-- 主体：左导航 + 右内容（半透明，让 Mica 透出，与主窗口一致） -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#B3F5F8FC"
                    BorderBrush="#E5E9F0" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,16,0,0">
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavRadio}" Tag="0" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Wrench24" FontSize="17" Margin="0,0,12,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="常规" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavData" Style="{StaticResource NavRadio}" Tag="1"
                                 IsChecked="True" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Database24" FontSize="17" Margin="0,0,12,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="数据管理" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavRadio}" Tag="2" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Info24" FontSize="17" Margin="0,0,12,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="关于" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <!-- 常规（占位） -->
                <StackPanel x:Name="PanelGeneral" Visibility="Collapsed" Margin="24,20">
                    <TextBlock Text="常规" Style="{StaticResource PanelTitle}"/>
                    <Border Height="1" Background="#E5E9F0" Margin="0,14,0,16"/>
                    <TextBlock Text="暂无更多设置，敬请期待。" Foreground="#5A6472" FontSize="13"/>
                </StackPanel>

                <!-- 数据管理 -->
                <Grid x:Name="PanelData" Visibility="Visible" Margin="24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="数据管理" Style="{StaticResource PanelTitle}"/>
                    <StackPanel Grid.Row="1">
                        <Border Height="1" Background="#E5E9F0" Margin="0,14,0,12"/>
                        <TextBlock Text="勾选需要清空数据的模块" FontSize="12" Foreground="#5A6472"/>
                    </StackPanel>

                    <Border Grid.Row="2" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="6"
                            Background="White" VerticalAlignment="Top" Margin="0,12,0,0">
                        <ItemsControl ItemsSource="{Binding Modules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#EDF0F5" BorderThickness="0,0,0,1" Padding="14,12">
                                        <CheckBox Style="{StaticResource ModuleCheckBox}"
                                                  IsChecked="{Binding IsChecked}"
                                                  Content="{Binding Name}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <ui:Button Content="清空选中数据" Click="Clear_Click" Appearance="Danger">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Delete24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <!-- 关于（占位） -->
                <StackPanel x:Name="PanelAbout" Visibility="Collapsed" Margin="24,20">
                    <TextBlock Text="关于" Style="{StaticResource PanelTitle}"/>
                    <Border Height="1" Background="#E5E9F0" Margin="0,14,0,16"/>
                    <TextBlock Text="桌面工具 deskApp" FontWeight="SemiBold" FontSize="14" Foreground="#1F1F1F"/>
                    <TextBlock Text="版本 1.0.0" Margin="0,8,0,0" Foreground="#5A6472" FontSize="13"/>
                    <TextBlock Text="装机软件管理与数据维护工具。" Margin="0,4,0,0" Foreground="#5A6472" FontSize="13"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
