<ui:FluentWindow x:Class="DeskApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeskApp"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="设置" Height="560" Width="760" WindowStartupLocation="Manual" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0" CaptionHeight="40"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 与主窗口同风格的自绘标题栏 -->
        <Grid Grid.Row="0" x:Name="TitleBarGrid" MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,10,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource CaptionBtn}" ToolTip="关闭" Click="Close_Click">
                <TextBlock Text="✕" FontSize="13"/>
            </Button>
        </Grid>

        <!-- 主体：左导航 + 右内容 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#B3F5F8FC"
                    BorderBrush="#E5E9F0" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,16,0,0">
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavRadio}" Tag="0" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Wrench24" FontSize="17" Margin="0,0,12,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="常规" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavModules" Style="{StaticResource NavRadio}" Tag="1"
                                 IsChecked="True" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Apps24" FontSize="17" Margin="0,0,12,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="模块管理" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavData" Style="{StaticResource NavRadio}" Tag="2" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Database24" FontSize="17" Margin="0,0,12,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="数据管理" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavHelp" Style="{StaticResource NavRadio}" Tag="4" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Question24" FontSize="17" Margin="0,0,12,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="使用说明" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavRadio}" Tag="3" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Info24" FontSize="17" Margin="0,0,12,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="关于 / 更新" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <!-- 常规 -->
                <StackPanel x:Name="PanelGeneral" Visibility="Collapsed" Margin="24,20">
                    <TextBlock Text="常规" Style="{StaticResource PanelTitle}"/>
                    <Border Height="1" Background="#E5E9F0" Margin="0,14,0,16"/>
                    <TextBlock Text="主界面显示哪些功能，请在「模块管理」里勾选。" FontSize="13" Foreground="#5A6472"/>
                    <TextBlock Text="各模块的数据可在「数据管理」里单独或批量清空。" FontSize="13"
                               Foreground="#5A6472" Margin="0,8,0,0"/>
                    <TextBlock Text="以后新增模块会自动出现在上述两处列表中，无需手动登记。" FontSize="13"
                               Foreground="#5A6472" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- 模块管理：全部模块 + 勾选是否上首页 + ↑↓ 调整顺序 -->
                <Grid x:Name="PanelModules" Visibility="Visible" Margin="24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="模块管理" Style="{StaticResource PanelTitle}"/>
                    <StackPanel Grid.Row="1">
                        <Border Height="1" Background="#E5E9F0" Margin="0,14,0,12"/>
                        <TextBlock Text="勾选后显示在主界面；用 ↑↓ 调整卡片顺序，新增模块自动排到末尾。"
                                   FontSize="12" Foreground="#5A6472" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Row="2" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="6"
                            Background="White" Margin="0,12,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="0,2">
                            <ItemsControl ItemsSource="{Binding ModuleToggles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#EDF0F5" BorderThickness="0,0,0,1" Padding="14,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="20"
                                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                                               FontWeight="SemiBold" Foreground="#1F1F1F"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                                               Foreground="#5A6472" Margin="0,3,0,0"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <Button Content="↑" Style="{StaticResource MiniIconButton}"
                                                            ToolTip="上移（主界面卡片往前排）"
                                                            IsEnabled="{Binding CanMoveUp}"
                                                            Click="MoveUp_Click"/>
                                                    <Button Content="↓" Style="{StaticResource MiniIconButton}"
                                                            ToolTip="下移（主界面卡片往后排）"
                                                            IsEnabled="{Binding CanMoveDown}"
                                                            Click="MoveDown_Click"/>
                                                    <CheckBox Style="{StaticResource ModuleCheckBox}"
                                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                              VerticalAlignment="Center" HorizontalAlignment="Right"
                                                              Margin="8,0,0,0" ToolTip="显示在主界面"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock Text="顺序即主界面卡片顺序，关闭设置后立即生效。"
                                   FontSize="11" Foreground="#8A94A3" VerticalAlignment="Center"/>
                        <ui:Button Content="恢复默认顺序" HorizontalAlignment="Right" Height="30"
                                   Padding="12,0" FontSize="12" Appearance="Secondary"
                                   Style="{StaticResource ActionButton}" Click="ResetOrder_Click"/>
                    </Grid>
                </Grid>

                <!-- 数据管理：全部模块 + 全选 -->
                <Grid x:Name="PanelData" Visibility="Collapsed" Margin="24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="数据管理" Style="{StaticResource PanelTitle}"/>
                    <StackPanel Grid.Row="1">
                        <Border Height="1" Background="#E5E9F0" Margin="0,14,0,12"/>
                        <Grid>
                            <TextBlock Text="勾选需要清空数据的模块" FontSize="12" Foreground="#5A6472"
                                       VerticalAlignment="Center"/>
                            <CheckBox x:Name="SelectAllBox" Style="{StaticResource ModuleCheckBox}"
                                      Content="全选" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="SelectAll_Changed" Unchecked="SelectAll_Changed"/>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="2" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="6"
                            Background="White" Margin="0,12,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="0,2">
                            <ItemsControl ItemsSource="{Binding Modules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#EDF0F5" BorderThickness="0,0,0,1" Padding="14,10">
                                            <CheckBox Style="{StaticResource ModuleCheckBox}"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                                <CheckBox.Content>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Icon}" FontSize="15"
                                                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                                   Foreground="#1F1F1F" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </CheckBox.Content>
                                            </CheckBox>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <ui:Button Content="清空选中数据" Click="Clear_Click" Appearance="Danger">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Delete24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <!-- 使用说明：左侧模块列表 + 右侧 Markdown 文档 -->
                <Grid x:Name="PanelHelp" Visibility="Collapsed" Margin="24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="使用说明" Style="{StaticResource PanelTitle}"/>
                    <StackPanel Grid.Row="1">
                        <Border Height="1" Background="#E5E9F0" Margin="0,14,0,10"/>
                        <TextBlock Text="按模块查看操作步骤。新增模块会自动出现在左侧列表，文档放在 Docs/Help/模块key.md。"
                                   FontSize="12" Foreground="#5A6472" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="168"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="6"
                                Background="White" Margin="0,0,10,0">
                            <ListBox x:Name="HelpModuleList" ItemsSource="{Binding HelpDocs}"
                                     SelectionChanged="HelpModule_SelectionChanged"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Padding="4,6">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="8,7"/>
                                        <Setter Property="Margin" Value="0,1"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" CornerRadius="5" Padding="{TemplateBinding Padding}"
                                                            Background="Transparent">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#E8F2FD"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#F2F6FB"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" FontSize="15" Margin="0,0,8,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#1F1F1F"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Border Grid.Column="1" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="6"
                                Background="White">
                            <FlowDocumentScrollViewer x:Name="HelpViewer"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      IsSelectionEnabled="True"/>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 关于 / 在线更新 -->
                <Grid x:Name="PanelAbout" Visibility="Collapsed" Margin="24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="关于" Style="{StaticResource PanelTitle}"/>
                    <StackPanel Grid.Row="1">
                        <Border Height="1" Background="#E5E9F0" Margin="0,14,0,16"/>
                        <TextBlock Text="桌面工具 deskApp" FontWeight="SemiBold" FontSize="14" Foreground="#1F1F1F"/>
                        <TextBlock x:Name="VersionText" Text="版本 1.0.0" Margin="0,8,0,0"
                                   Foreground="#5A6472" FontSize="13"/>
                        <TextBlock Text="装机软件管理与数据维护工具。" Margin="0,4,0,0"
                                   Foreground="#5A6472" FontSize="13"/>
                        <TextBlock Text="更新源：github.com/zhaosai6869/deskTool/releases" Margin="0,4,0,0"
                                   Foreground="#5A6472" FontSize="12"/>
                        <TextBlock Text="发布新版本：在 GitHub 创建 Release（标签形如 v1.0.1），并上传包含 DeskApp.exe 与全部依赖文件的 zip 附件。"
                                   Margin="0,8,0,0" Foreground="#8A94A3" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                        <ui:Button Content="查看使用说明" Appearance="Secondary"
                                   Style="{StaticResource ActionButton}"
                                   Click="OpenHelp_Click" Margin="0,0,12,0"/>
                        <ui:Button x:Name="CheckUpdateBtn" Content="检查更新" Appearance="Secondary"
                                   Style="{StaticResource ActionButton}"
                                   Click="CheckUpdate_Click"/>
                        <ui:Button x:Name="UpdateBtn" Content="下载并安装更新" Appearance="Secondary"
                                   Style="{StaticResource ActionButton}"
                                   Visibility="Collapsed" Click="Update_Click"
                                   Margin="12,0,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="3" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="6"
                            Background="White" Margin="0,14,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
                            <TextBlock x:Name="ReleaseNotes" Text="点击「检查更新」查看是否有新版本。"
                                       FontSize="12" Foreground="#5A6472" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Grid.Row="4" x:Name="UpdateStatus" Text="" FontSize="12"
                               Foreground="#0F6CBD" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
