<UserControl x:Class="DeskApp.ComicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="920">

    <UserControl.Resources>
        <Style x:Key="PrimaryBlueButton" TargetType="ui:Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0F6CBD"/>
            <Setter Property="BorderBrush" Value="#0F6CBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0B5AA6"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0B5AA6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#084B8A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 网站快捷入口小按钮 -->
        <Style x:Key="SiteChipButton" TargetType="Button">
            <Setter Property="Height" Value="27"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#0F6CBD"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9DCF2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8F2FD"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0F6CBD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D4E7FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="漫画下载" FontSize="19" FontWeight="Bold"
                       Foreground="#1F1F1F" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock Grid.Column="1" Text="粘贴目录页网址，通用规则抓图打包 CBZ / PDF" FontSize="12"
                       Foreground="#5A6472" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding BookTitle}" FontSize="12"
                       Foreground="#0F6CBD" VerticalAlignment="Center" HorizontalAlignment="Right"
                       MaxWidth="260" TextTrimming="CharacterEllipsis"/>
        </Grid>

        <!-- 漫画网站快捷入口：点网站名用系统浏览器打开，支持增删/恢复默认 -->
        <Border Grid.Row="1" Background="#F5F8FC" BorderBrush="#E5E9F0" BorderThickness="1"
                CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="漫画网站" Style="{StaticResource FieldLabel}"
                           Margin="0,0,10,0" VerticalAlignment="Center"/>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Sites}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}" Style="{StaticResource SiteChipButton}"
                                    ToolTip="{Binding Url}" Margin="0,2,6,2"
                                    Click="Site_Click" Tag="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <ui:Button Content="添加" Style="{StaticResource ActionButton}" Height="28" Padding="10,0"
                               Click="AddSite_Click" ToolTip="添加漫画网站"/>
                    <ui:Button Content="管理" Style="{StaticResource ActionButton}" Height="28" Padding="10,0"
                               Margin="6,0,0,0" Click="ManageSites_Click" ToolTip="编辑或删除漫画网站"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 网址输入 -->
        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="目录页网址" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
            <TextBox x:Name="UrlBox" Grid.Column="1" Style="{StaticResource Input}"
                     Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="UrlBox_KeyDown"
                     ToolTip="粘贴漫画目录页（章节列表页）的完整网址"/>
            <ui:Button x:Name="ParseBtn" Grid.Column="2" Content="解析章节" Style="{StaticResource PrimaryBlueButton}"
                       Width="100" Margin="10,0,0,0" Click="Parse_Click"/>
            <ui:Button x:Name="CancelBtn" Grid.Column="3" Content="取消" Style="{StaticResource ActionButton}"
                       Height="32" Padding="12,0" Margin="8,0,0,0" Click="Cancel_Click"/>
        </Grid>

        <!-- 手动校正 + 导出格式 -->
        <Border Grid.Row="3" Background="#F5F8FC" BorderBrush="#E5E9F0" BorderThickness="1"
                CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="章节选择器" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                <TextBox Grid.Column="1" Style="{StaticResource Input}"
                         Text="{Binding ChapterSelector, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="识别不准时填，如 a.chapter 或 #chapter-list a"/>
                <TextBlock Grid.Column="2" Text="图片选择器" Style="{StaticResource FieldLabel}" Margin="12,0,6,0"/>
                <TextBox Grid.Column="3" Style="{StaticResource Input}"
                         Text="{Binding ImageSelector, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="图片抓不到时填，如 #content img 或 .chapter-content img"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <CheckBox Content="CBZ" IsChecked="{Binding ExportCbz, Mode=TwoWay}"
                              Style="{StaticResource ModuleCheckBox}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox Content="PDF" IsChecked="{Binding ExportPdf, Mode=TwoWay}"
                              Style="{StaticResource ModuleCheckBox}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 章节列表 -->
        <DataGrid Grid.Row="4" x:Name="ChapterGrid" Style="{StaticResource AppDataGrid}"
                  ItemsSource="{Binding Chapters}" CanUserSortColumns="True">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Row_PreviewMouseLeftButtonDown"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="38" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource ModuleCheckBox}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsHitTestVisible="False"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="章节标题" Width="*" Binding="{Binding Title}"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="图片数" Width="80" Binding="{Binding ImageCount}"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="状态" Width="180" Binding="{Binding Status}"
                                    ElementStyle="{StaticResource CellText}">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="ToolTip" Value="{Binding Status}"/>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 勾选 / 进度 -->
        <Grid Grid.Row="5" Margin="0,8,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:Button x:Name="SelectAllBtn" Grid.Column="0" Content="全选" Style="{StaticResource ActionButton}"
                       Height="30" Padding="12,0" Click="SelectAll_Click"/>
            <ui:Button x:Name="UnselectBtn" Grid.Column="1" Content="取消全选" Style="{StaticResource ActionButton}"
                       Height="30" Padding="12,0" Margin="8,0,0,0" Click="Unselect_Click"/>
            <TextBlock Grid.Column="2" FontSize="13" Foreground="#0F6CBD" VerticalAlignment="Center" Margin="14,0,0,0">
                <Run Text="已选 "/><Run Text="{Binding SelectedCount, Mode=OneWay}"/><Run Text=" / "/>
                <Run Text="{Binding Chapters.Count, Mode=OneWay}"/><Run Text=" 章"/>
            </TextBlock>
            <TextBlock Grid.Column="3" FontSize="12" Foreground="#5A6472" VerticalAlignment="Center">
                <Run Text="{Binding Progress, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding ProgressTotal, Mode=OneWay}"/>
            </TextBlock>
        </Grid>

        <!-- 保存目录 / 下载 -->
        <Grid Grid.Row="6" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="保存到" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
            <TextBox Grid.Column="1" Style="{StaticResource Input}"
                     Text="{Binding DownloadDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <ui:Button x:Name="BrowseBtn" Grid.Column="2" Content="浏览..." Style="{StaticResource ActionButton}"
                       Height="32" Padding="12,0" Margin="8,0,0,0" Click="Browse_Click"/>
            <ui:Button x:Name="OpenDirBtn" Grid.Column="3" Content="打开文件夹" Style="{StaticResource ActionButton}"
                       Height="32" Padding="12,0" Margin="6,0,0,0" Click="OpenDir_Click"/>
            <ui:Button x:Name="DownloadBtn" Grid.Column="4" Content="开始下载" Style="{StaticResource PrimaryBlueButton}"
                       Width="110" Margin="10,0,0,0" Click="Download_Click"/>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="7" Background="#F5F8FC" BorderBrush="#E5E9F0" BorderThickness="1"
                CornerRadius="6" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="12" Foreground="#5A6472"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="资源版权归原平台及权利人所有 · 仅供个人学习" FontSize="11"
                           Foreground="#8A94A3" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
