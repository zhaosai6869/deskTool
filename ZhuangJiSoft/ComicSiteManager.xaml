<ui:FluentWindow x:Class="DeskApp.ComicSiteManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="管理漫画网站" Height="440" Width="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0" CaptionHeight="40"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent">
            <TextBlock Text="管理漫画网站" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="16,0"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding Sites.Count, StringFormat='共 {0} 个网站'}"
                   FontSize="12" Foreground="#5A6472" Margin="20,4,20,8"/>

        <Border Grid.Row="2" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="6"
                Background="White" Margin="20,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                <ItemsControl x:Name="SiteList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#EDF0F5" BorderThickness="0,0,0,1" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#1F1F1F"/>
                                        <TextBlock Text="{Binding Url}" FontSize="11" Foreground="#8A94A3"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Content="编辑" Style="{StaticResource ActionButton}"
                                                   Height="28" Padding="12,0" Click="EditSite_Click" Tag="{Binding}"/>
                                        <ui:Button Content="删除" Style="{StaticResource ActionButton}"
                                                   Height="28" Padding="12,0" Margin="6,0,0,0"
                                                   Appearance="Danger" Click="DeleteSite_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="20,14">
            <ui:Button Content="添加网站" Appearance="Primary" Height="32" Padding="16,0"
                       Click="AddSite_Click"/>
            <ui:Button Content="恢复默认" Style="{StaticResource ActionButton}" Height="32" Padding="16,0"
                       Margin="10,0,0,0" Click="ResetSites_Click"/>
            <ui:Button Content="关闭" Style="{StaticResource ActionButton}" Height="32" Padding="20,0"
                       Margin="10,0,0,0" Click="Close_Click" HorizontalAlignment="Right"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
