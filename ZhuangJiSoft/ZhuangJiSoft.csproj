<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DeskApp</AssemblyName>
    <RootNamespace>DeskApp</RootNamespace>
    <!-- 在线更新以程序集版本与 GitHub Release 标签（vX.Y.Z）比较 -->
    <Version>1.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.34" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <!-- SSH 远程：SSH/SFTP 协议栈、FTP/FTPS 协议栈、内嵌终端 WebView2 承载 xterm.js -->
    <PackageReference Include="SSH.NET" Version="2026.0.1" />
    <PackageReference Include="FluentFTP" Version="52.1.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <!-- 第一试卷网为 gb2312/gb18030 编码，需要 CodePages 提供 GB18030 -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <!-- 第一试卷下载：纯托管解压 RAR5/ZIP/7z，提取其中的 Office 文件 -->
    <PackageReference Include="SharpCompress" Version="0.50.9" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 使用说明：Docs/Help/{模块key}.md 嵌入程序集，随 ModuleCatalog 自动发现，
       新增模块只需补一个同名 md 文件即可出现在设置→使用说明，无需改代码 -->
  <ItemGroup>
    <EmbeddedResource Include="Docs\Help\*.md" />
  </ItemGroup>

</Project>
