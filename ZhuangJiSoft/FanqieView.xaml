<UserControl x:Class="DeskApp.FanqieView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="900">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 + 说明 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <ui:TextBlock Text="番茄小说下载" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                          Margin="0,0,16,0" Foreground="#1F1F1F"/>
            <TextBlock Text="按书名搜索或输入书号/目录链接，导出 TXT（正文自动解码）" FontSize="13"
                       Foreground="#5A6472" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 保存模式 + 目录 + 清空 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <CheckBox x:Name="SingleFileCheck" Content="整本合并为一个 TXT（取消则每章一个文件）"
                      Style="{StaticResource ModuleCheckBox}"
                      IsChecked="{Binding SingleFile, Mode=TwoWay}" Margin="0,0,18,0"/>
            <ui:Button Content="选择目录" Click="PickDir_Click" Margin="0,0,10,0" Appearance="Secondary"
                       Style="{StaticResource ActionButton}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="FolderOpen24"/>
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="清空记录" Click="Clear_Click" Appearance="Danger"
                       Style="{StaticResource ActionButton}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Delete24"/>
                </ui:Button.Icon>
            </ui:Button>
        </StackPanel>

        <Border Grid.Row="2" Height="1" Background="#E5E9F0" Margin="0,0,0,12"/>

        <!-- 输入区：名称搜索 + 书号/链接 + 下载 + 取消 -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Content="按名称搜索" Click="Search_Click" Margin="0,0,10,0"
                       Appearance="Secondary" Height="40" Style="{StaticResource ActionButton}"
                       ToolTip="打开内嵌浏览器搜索；若出现滑块验证请手动完成">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Cloud24"/>
                </ui:Button.Icon>
            </ui:Button>
            <TextBox x:Name="LinkBox" Grid.Column="1" Style="{StaticResource Input}"
                     Height="40" VerticalContentAlignment="Center" Padding="10,0"
                     ToolTip="粘贴目录页链接或填小说 ID，如 fanqienovel.com/page/7276384138653862966"/>
            <ui:Button x:Name="DownloadBtn" Grid.Column="2" Content="下载" Click="Download_Click"
                       Margin="10,0,0,0" Appearance="Primary" Height="40" Width="100"
                       Style="{StaticResource ActionButton}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowDownload24"/>
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button x:Name="CancelBtn" Grid.Column="3" Content="取消" Click="Cancel_Click"
                       Margin="10,0,0,0" Appearance="Secondary" Height="40" Width="80"
                       Style="{StaticResource ActionButton}" IsEnabled="False"/>
        </Grid>

        <!-- 记录表格：右键重下/打开位置/复制链接 -->
        <DataGrid Grid.Row="4" x:Name="Grid"
                  Style="{StaticResource AppDataGrid}"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  MouseRightButtonDown="Grid_MouseRightButtonDown">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="重新下载" Click="Retry_Click"/>
                    <MenuItem Header="打开文件位置" Click="OpenFolder_Click"/>
                    <MenuItem Header="复制链接" Click="CopyLink_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="书名" Width="220"
                                    ElementStyle="{StaticResource CellText}" Binding="{Binding Title}"/>
                <DataGridTextColumn Header="作者" Width="110"
                                    ElementStyle="{StaticResource CellText}" Binding="{Binding Author}"/>
                <DataGridTextColumn Header="进度" Width="150"
                                    ElementStyle="{StaticResource CellText}" Binding="{Binding ProgressText}"/>
                <DataGridTextColumn Header="大小" Width="90"
                                    ElementStyle="{StaticResource CellText}" Binding="{Binding SizeText}"/>
                <DataGridTextColumn Header="状态" Width="90" Binding="{Binding Status}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                            <Setter Property="ToolTip" Value="{Binding Error}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Error}" Value="">
                                    <Setter Property="ToolTip" Value="{x:Null}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="失败">
                                    <Setter Property="Foreground" Value="#D13438"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="已下载">
                                    <Setter Property="Foreground" Value="#1F8A4C"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="已跳过">
                                    <Setter Property="Foreground" Value="#8A94A3"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="时间" Width="*"
                                    ElementStyle="{StaticResource CellText}" Binding="{Binding TimeText}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
