<ui:FluentWindow x:Class="DeskApp.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="桌面工具" Height="600" Width="820"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0" CaptionHeight="40"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自定义标题栏：左侧标题/返回，右侧 设置/最小化/关闭 同一行 -->
        <Grid Grid.Row="0" x:Name="TitleBarGrid" MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <ui:SymbolIcon Symbol="Apps24" FontSize="16" Margin="0,0,10,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="桌面工具" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ui:Button x:Name="BackButton" Content="← 返回" Visibility="Collapsed"
                           Appearance="Transparent" FontSize="13" Padding="10,4" Margin="18,0,0,0"
                           VerticalAlignment="Center" Click="Back_Click"
                           WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SettingsButton" Style="{StaticResource CaptionBtn}"
                        ToolTip="设置" Click="Settings_Click">
                    <ui:SymbolIcon Symbol="Settings24" FontSize="17"/>
                </Button>
                <Button Style="{StaticResource CaptionBtn}" ToolTip="最小化" Click="Minimize_Click">
                    <TextBlock Text="—" FontSize="14"/>
                </Button>
                <Button Style="{StaticResource CaptionBtn}" ToolTip="关闭" Click="Close_Click">
                    <TextBlock Text="✕" FontSize="13"/>
                </Button>
            </StackPanel>
        </Grid>

        <ContentControl Grid.Row="1" x:Name="PageHost" />
    </Grid>
</ui:FluentWindow>
