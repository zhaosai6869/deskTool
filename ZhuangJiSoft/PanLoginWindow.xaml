<ui:FluentWindow x:Class="DeskApp.PanLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="网盘登录" Height="720" Width="1020" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16,12,16,8">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="网盘登录" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock x:Name="TipText" Text="请在官方页面中完成登录（扫码 / 账号密码 / 短信均可），登录后程序会自动读取凭据。"
                           FontSize="12" Foreground="#5A6472" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="12,0">
            <wv2:WebView2 x:Name="LoginView" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"/>
            <Border x:Name="LoadingMask" Background="#CCFFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="正在加载登录页…" FontSize="13" Foreground="#5A6472" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="#0F6CBD"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="重新加载" Style="{StaticResource ActionButton}" Height="32" Padding="14,0"
                               Click="Reload_Click"/>
                    <ui:Button Content="登录完成，保存凭据" Appearance="Primary" Height="32" Padding="16,0"
                               Margin="8,0,0,0" Click="Save_Click"/>
                    <ui:Button Content="取消" Style="{StaticResource ActionButton}" Height="32" Padding="16,0"
                               Margin="8,0,0,0" Click="Cancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
