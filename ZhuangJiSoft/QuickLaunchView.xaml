<UserControl x:Class="DeskApp.QuickLaunchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:DeskApp"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="900">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 第一行：标题 + 说明 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <ui:TextBlock Text="一键启动" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                          Margin="0,0,16,0" Foreground="#1F1F1F"/>
            <TextBlock Text="按模式分组启动一组软件（应用清单来自系统已安装程序）" FontSize="13" Foreground="#5A6472"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 第二行：模式选择 + 新建/重命名/删除 + 一键启动 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <ComboBox x:Name="ModeBox" Width="220" Style="{StaticResource AppComboBox}"
                      ItemsSource="{Binding Modes}"
                      SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                      ItemTemplate="{StaticResource AppComboBoxItemTemplate}"
                      ItemContainerStyle="{StaticResource AppComboBoxItem}"
                      ToolTip="选择启动模式"/>
            <ui:Button Content="新建" Click="AddMode_Click" Margin="10,0,0,0" Appearance="Secondary"
                       Style="{StaticResource ActionButton}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Add24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="重命名" Click="RenameMode_Click" Margin="10,0,0,0" Appearance="Secondary"
                       Style="{StaticResource ActionButton}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Rename24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="删除" Click="DeleteMode_Click" Margin="10,0,0,0" Appearance="Danger"
                       Style="{StaticResource ActionButton}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Delete24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="一键启动" Click="LaunchAll_Click" Margin="16,0,0,0" Appearance="Primary"
                       Style="{StaticResource ActionButton}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Rocket24" />
                </ui:Button.Icon>
            </ui:Button>
        </StackPanel>

        <Border Grid.Row="2" Height="1" Background="#E5E9F0" Margin="0,0,0,12"/>

        <!-- 第三行：应用下拉 + 添加 + 浏览 -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="AppBox" Grid.Column="0" Style="{StaticResource AppComboBox}"
                      ItemsSource="{Binding AppOptions}"
                      SelectedItem="{Binding SelectedApp, Mode=TwoWay}"
                      ItemTemplate="{StaticResource AppComboBoxItemTemplate}"
                      ItemContainerStyle="{StaticResource AppComboBoxItem}"
                      ToolTip="系统已安装程序（注册表 + 开始菜单），滚轮/滚动条快速上下，选中后点「添加」"/>
            <ui:Button Grid.Column="1" Content="添加" Click="AddApp_Click" Margin="10,0,0,0" Appearance="Secondary"
                       Style="{StaticResource ActionButton}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Add24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Grid.Column="2" Content="浏览…" Click="Browse_Click" Margin="10,0,0,0" Appearance="Secondary"
                       Style="{StaticResource ActionButton}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>

        <!-- 启动项表格：右键单独启动/移除 -->
        <DataGrid Grid.Row="4" x:Name="Grid"
                  Style="{StaticResource AppDataGrid}"
                  ItemsSource="{Binding Items}"
                  MouseRightButtonDown="Grid_MouseRightButtonDown">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="单独启动" Click="LaunchOne_Click"/>
                    <MenuItem Header="移除此项" Click="RemoveItem_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="程序" Width="220"
                                    ElementStyle="{StaticResource CellText}" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="路径" Width="300"
                                    ElementStyle="{StaticResource CellText}" Binding="{Binding Target}"/>
                <DataGridTextColumn Header="参数" Width="*"
                                    ElementStyle="{StaticResource CellText}" Binding="{Binding Arguments}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
