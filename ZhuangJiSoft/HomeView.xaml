<UserControl x:Class="DeskApp.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:DeskApp"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="820">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,8,0,16">
            <ui:TextBlock Text="桌面工具" FontSize="30" FontWeight="Bold"
                          HorizontalAlignment="Center" Foreground="#1F1F1F"/>
            <Border Width="72" Height="2" Background="#0F6CBD" CornerRadius="1"
                    HorizontalAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Tools}"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:Button Width="118" Height="120" Margin="5" Padding="0"
                               Appearance="Secondary" Cursor="Hand"
                               Click="Tool_Click">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Icon}" FontSize="38" HorizontalAlignment="Center"/>
                            <ui:TextBlock Text="{Binding Name}" FontSize="13" HorizontalAlignment="Center"
                                          Margin="0,8,0,0" Foreground="#1F1F1F"/>
                        </StackPanel>
                    </ui:Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
