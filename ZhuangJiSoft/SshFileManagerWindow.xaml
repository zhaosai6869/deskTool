<ui:FluentWindow x:Class="DeskApp.SshFileManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="文件管理" Height="620" Width="1060"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0" CaptionHeight="40"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="TitleBarGrid" MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" Margin="0,0,10,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock x:Name="TitleText" Text="文件管理" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource CaptionBtn}" ToolTip="最小化" Click="Minimize_Click">
                    <TextBlock Text="—" FontSize="14"/>
                </Button>
                <Button Style="{StaticResource CaptionBtn}" ToolTip="关闭" Click="Close_Click">
                    <TextBlock Text="✕" FontSize="13"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,0,16,10">
            <ui:Button Content="刷新" Click="Refresh_Click" Margin="0,0,8,0" Appearance="Secondary"
                      Style="{StaticResource ActionButton}">
                <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise24"/></ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="上传 →" Click="Upload_Click" Margin="0,0,8,0" Appearance="Primary"
                      Style="{StaticResource ActionButton}">
                <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowUpload24"/></ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="← 下载" Click="Download_Click" Margin="0,0,8,0" Appearance="Primary"
                      Style="{StaticResource ActionButton}">
                <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowDownload24"/></ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="新建文件夹" Click="Mkdir_Click" Margin="0,0,8,0" Appearance="Secondary"
                      Style="{StaticResource ActionButton}">
                <ui:Button.Icon><ui:SymbolIcon Symbol="FolderAdd24"/></ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="重命名" Click="Rename_Click" Margin="0,0,8,0" Appearance="Secondary"
                      Style="{StaticResource ActionButton}">
                <ui:Button.Icon><ui:SymbolIcon Symbol="Rename24"/></ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="删除" Click="Delete_Click" Appearance="Danger"
                      Style="{StaticResource ActionButton}">
                <ui:Button.Icon><ui:SymbolIcon Symbol="Delete24"/></ui:Button.Icon>
            </ui:Button>
        </StackPanel>

        <!-- 双栏路径 -->
        <Grid Grid.Row="2" Margin="16,0,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="4" Background="White">
                <TextBlock x:Name="LocalPathText" Text="本地：" FontSize="12" Foreground="#5A6472"
                           Margin="10,6" TextTrimming="CharacterEllipsis"/>
            </Border>
            <Border Grid.Column="2" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="4" Background="White">
                <TextBlock x:Name="RemotePathText" Text="远端：/" FontSize="12" Foreground="#5A6472"
                           Margin="10,6" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>

        <!-- 双栏文件列表 -->
        <Grid Grid.Row="3" Margin="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" x:Name="LocalGrid" Style="{StaticResource AppDataGrid}"
                      ItemsSource="{Binding LocalItems}" MouseDoubleClick="LocalGrid_DoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="本地文件" Width="*"
                                        ElementStyle="{StaticResource CellText}" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="大小" Width="90"
                                        ElementStyle="{StaticResource CellText}" Binding="{Binding SizeText}"/>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid Grid.Column="2" x:Name="RemoteGrid" Style="{StaticResource AppDataGrid}"
                      ItemsSource="{Binding RemoteItems}" MouseDoubleClick="RemoteGrid_DoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="远端文件" Width="*"
                                        ElementStyle="{StaticResource CellText}" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="大小" Width="90"
                                        ElementStyle="{StaticResource CellText}" Binding="{Binding SizeText}"/>
                    <DataGridTextColumn Header="修改时间" Width="140"
                                        ElementStyle="{StaticResource CellText}" Binding="{Binding Modified}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <TextBlock Grid.Row="4" x:Name="StatusText" Text="正在连接…" FontSize="12" Foreground="#5A6472"
                   Margin="16,10,16,12"/>
    </Grid>
</ui:FluentWindow>
