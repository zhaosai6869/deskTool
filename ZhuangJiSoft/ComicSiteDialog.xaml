<ui:FluentWindow x:Class="DeskApp.ComicSiteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:DeskApp"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="漫画网站" Height="230" Width="480" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0" CaptionHeight="40"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent">
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="20,6,20,0">
            <TextBlock Text="网站名称" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <TextBox x:Name="NameBox" Style="{StaticResource Input}" Height="32"
                     ToolTip="如：哔哩哔哩漫画"/>
            <TextBlock Text="首页网址" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
            <TextBox x:Name="UrlBox" Style="{StaticResource Input}" Height="32"
                     ToolTip="如：https://manga.bilibili.com"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,12">
            <ui:Button Content="取消" Style="{StaticResource ActionButton}" Height="32" Padding="16,0"
                       Click="Cancel_Click"/>
            <ui:Button Content="保存" Appearance="Primary" Height="32" Padding="18,0"
                       Margin="10,0,0,0" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
