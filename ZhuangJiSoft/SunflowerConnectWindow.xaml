<Window x:Class="DeskApp.SunflowerConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="向日葵连接信息" Width="380" SizeToContent="Height"
        WindowStartupLocation="Manual" ResizeMode="NoResize"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False" Background="#FBFBFD">
    <Grid Margin="18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="向日葵连接信息" FontSize="15" FontWeight="SemiBold"
                   Foreground="#1F1F1F"/>

        <TextBlock Grid.Row="1" Margin="0,4,0,14" FontSize="11" Foreground="#5A6472"
                   Text="识别码已复制到剪贴板，在向日葵【远程协助】中粘贴即可。"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="66"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="识别码" Style="{StaticResource FieldLabel}"/>
            <TextBlock x:Name="CodeText" Grid.Column="1" FontSize="14" FontWeight="SemiBold"
                       Foreground="#1F1F1F" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <ui:Button x:Name="CopyCodeBtn" Grid.Column="2" Content="复制" Width="62"
                       Appearance="Secondary" Style="{StaticResource ActionButton}"
                       Margin="8,0,0,0" Click="CopyCode_Click"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="66"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="访问密码" Style="{StaticResource FieldLabel}"/>
            <TextBlock x:Name="PwdText" Grid.Column="1" FontSize="14" FontWeight="SemiBold"
                       Foreground="#1F1F1F" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <ui:Button x:Name="CopyPwdBtn" Grid.Column="2" Content="复制" Width="62"
                       Appearance="Secondary" Style="{StaticResource ActionButton}"
                       Margin="8,0,0,0" Click="CopyPwd_Click"/>
        </Grid>

        <TextBlock Grid.Row="4" Margin="0,14,0,0" FontSize="11" Foreground="#5A6472"
                   Text="点击「复制密码」后 5 秒自动关闭；也可直接关闭本窗口。"/>
    </Grid>
</Window>
